# Configuration du client web. En local : copier en .env.local (jamais committé).
# En production, ces variables sont fixées par deploy/compose.prod.yaml sur l'instance EC2.

# Adresse de l'API Delibera vue depuis le serveur Next.js (sans /api/v1).
DELIBERA_API_URL=http://localhost:8080

# Cookies « Secure » : true dès que le site est servi en HTTPS.
DELIBERA_COOKIES_SECURISES=false

# Durée maximale du cookie du jeton de renouvellement, en secondes (l'API reste seule juge).
DELIBERA_DUREE_RENOUVELLEMENT=28800

# Délai maximal d'un appel à l'API, en millisecondes.
DELIBERA_DELAI_API_MS=30000

# Développement seulement : session fictive (toutes les permissions d'un gestionnaire) pour
# construire les écrans avant que l'authentification de l'API existe. Ignorée en production.
DELIBERA_SESSION_FICTIVE=false
